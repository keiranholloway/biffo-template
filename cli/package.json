{
  "name": "@biffo/cli",
  "version": "0.0.0",
  "description": "Biffo project scaffolding CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "biffo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keiranholloway/biffo-template.git",
    "directory": "cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "schemas",
    "_skeletons",
    "scripts/wait-for-checks.sh",
    "scripts/branch-health.sh",
    "scripts/claim.sh",
    "scripts/hook-audit.sh",
    "scripts/pg-test-db.sh",
    "scripts/rewrite-scope-check.sh",
    "scripts/pgtest-diff-check.sh",
    "scripts/gate-coverage.sh",
    "scripts/verify.sh",
    "scripts/runner-drop-forensics.mjs",
    "scripts/practices-metrics.mjs",
    "scripts/practices-corpus.mjs"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "node scripts/sync-packaged-assets.mjs",
    "postpack": "node scripts/sync-packaged-assets.mjs --clean",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:release-subject": "tsx src/index.ts check release-subject",
    "check:core-ownership": "tsx src/index.ts check ownership",
    "check:plugin-terraform": "tsx src/index.ts check plugin-terraform",
    "sync:core-tag": "tsx src/scripts/sync-core-tag.ts",
    "report:publish-failure": "tsx src/scripts/report-publish-failure.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.726.1",
    "@aws-sdk/client-iam": "^3.726.1",
    "@aws-sdk/client-lambda": "^3.726.1",
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/client-sts": "^3.726.1",
    "@octokit/rest": "^21.0.2",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "inquirer": "^12.3.0",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biffo/eslint-config": "workspace:*",
    "@biffo/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.1.0",
    "eslint": "^9.18.0",
    "msw": "^2.14.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  }
}
