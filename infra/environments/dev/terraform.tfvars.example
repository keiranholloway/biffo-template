# Copy to terraform.tfvars and fill in values.
# terraform.tfvars is gitignored — never commit real values.

project_name   = "my-project"
aws_region     = "us-east-1"
admin_email    = "admin@example.com"
admin_username = "admin"

# Optional: send Cognito admin-password emails from a verified SES identity
# instead of the default Cognito no-reply sender. Leave blank to keep defaults.
# mail_from_address = "admin-env@mail.example.com"
# mail_source_arn   = "arn:aws:ses:us-east-1:111111111111:identity/mail.example.com"

# Optional: plugins to provision (ADR-0003). Each name must have a matching
# module "plugin_<name>" block in main.tf and a module directory at
# modules/plugins/<name>/ — see infra/environments/dev/README.md.
# enabled_plugins = ["rbac"]

# Optional: endpoint control plane — isolated PR-signer (ADR-0008). Requires a
# registered GitHub App with contents:write + pull_requests:write on this repo;
# see docs/guides/endpoint-control-plane-setup.md. After apply, upload the App
# private key (PEM) to the created secret out-of-band — never put it here.
# enable_pr_signer                 = true
# pr_signer_github_app_id          = "123456"
# pr_signer_github_installation_id = "45678901"
# pr_signer_repo_owner             = "my-org"
# pr_signer_repo_name              = "my-project"
# pr_signer_base_branch            = "main"
